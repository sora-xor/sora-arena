+    if sha(root / item["file"]) != item["sha256"] or item["sha256"] not in {f["sha256"] for f in wood["files"]}:
+        raise RuntimeError(f"Kura front wood input changed: {role}")
+
+dest = "/Game/Generated/ArtReview/KuraFront"
