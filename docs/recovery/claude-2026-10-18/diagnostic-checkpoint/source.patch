+void CaptureSoraArtReview(const TCHAR* Label)
+{
+    const FString Filename=FPaths::Combine(FPaths::ScreenShotDir(),
+        FString::Printf(TEXT("SoraArtReview_%s.png"),Label));
+    FScreenshotRequest::RequestScreenshot(Filename,false,false);
+    UE_LOG(LogTemp,Display,TEXT("SORA_ART_REVIEW_REQUEST: %s"),*Filename);
+}
+
+// Isolated UE 5.8.3 diagnostic only. These transient meshes are visual-only,
+// never added to WorldBuilder, authored collision, saves, or the release tree.
+AStaticMeshActor* SpawnSoraFernReview(UWorld* World)
+{
+    const FString Path=TEXT("/Game/Generated/ArtReview/Fern02/GroundTransition/Meshes/SM_NyaagyuFernGroundTransition_HI.SM_NyaagyuFernGroundTransition_HI");
+    UStaticMesh* Mesh=LoadObject<UStaticMesh>(nullptr,*Path);
+    if(!Mesh) { UE_LOG(LogTemp,Error,TEXT("FERN_GROUND_ART_REVIEW_ASSET_MISSING: %s"),*Path); return nullptr; }
+    // X [-2103,-1777], Y [272,396] cm at 1x. The central path, torii
+    // posts, lantern and cargo cover remain outside this visual-only envelope.
+    AStaticMeshActor* Actor=World->SpawnActor<AStaticMeshActor>(FVector(-1950,335,0),FRotator::ZeroRotator);
+    if(!Actor) return nullptr;
+    UStaticMeshComponent* C=Actor->GetStaticMeshComponent();
+    C->SetMobility(EComponentMobility::Movable);
+    if(!C->SetStaticMesh(Mesh) || C->GetStaticMesh()!=Mesh)
+    {
+        UE_LOG(LogTemp,Error,TEXT("FERN_GROUND_ART_REVIEW_ASSIGN_FAILED: %s"),*Path);
+        Actor->Destroy();
+        return nullptr;
+    }
+    C->SetCollisionEnabled(ECollisionEnabled::NoCollision);
+    C->SetGenerateOverlapEvents(false);
+    UE_LOG(LogTemp,Display,TEXT("FERN_GROUND_ART_REVIEW_SPAWNED: one visual-only contacted cluster on north shoulder"));
+    return Actor;
+}
+}
 
