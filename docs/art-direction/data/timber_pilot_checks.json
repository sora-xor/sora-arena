 "uv_contract": {
  "geometry": "sora-timber-geometry-v2.2",
  "unreal_content_path": "/Game/Generated/Qualification/DojoTimberPilotV22",
  "master": "a dedicated PilotV22 timber master (and fallback master) in the PilotV22 content path that decodes UV4 and applies the v2.2 ring formula below (the wander and the year waves); never the baseline timber_master, whose ring model and four channels do not apply, nor the v2.1 formula. Not implemented in the importer yet.",
  "readback": "after import, before any material review: read back each PilotV22 static mesh's UV channel count (5) and, at known source vertices, the decoded UV0, UVLogQ, UVLogZ seed and UVKnot values against the FBX source (to 1e-6), and the material's resolved parent and sampler types.",
  "import_decode": "Interchange imports every channel as (U, 1 - V). Decode with flip_v before reading UV0/UVLogQ/UVLogZ/UVKnot as data; sample shared images at computed Blender coordinates through sample_blender (flip_v again), as import_nyaagyu_dojo_timbers.py (cd10643) does.",
  "channels": [
   {
    "index": 0,
    "blender_layer": "UV0",
    "payload": "metric (s, z): arc length round the section, height (m)",
    "unreal": "flip_v(TexCoord[0])"
   },
   {
    "index": 1,
    "blender_layer": "UV1",
    "payload": "unique bake atlas (fallback NormalDX/Masks)",
    "unreal": "TexCoord[1] as imported"
   },
   {
    "index": 2,
    "blender_layer": "UVLogQ",
    "payload": "signed log-frame offset q = (P - pith) * r_warp / r (m). r_warp adds the periodic wobble (sora_timber_v2.wobble) and every knot's swirl. Continuous across knot edges: no knot-centred swap (that was v2).",
    "unreal": "flip_v(TexCoord[2])"
   },
   {
    "index": 3,
    "blender_layer": "UVLogZ",
    "payload": "(z m, seed01)",
    "unreal": "seed = 1 - TexCoord[3].g"
   },
   {
    "index": 4,
    "blender_layer": "UVKnot",
    "payload": "(knot ring radius r_k in the materials' ring units (0.55 mm knot rings), signed distance d from the knot's edge in knot radii, clamped to [-1, 1]); inside the knot where d < 0. Fallbacks carry (0, 1).",
    "unreal": "r_k = TexCoord[4].r; d = 1 - TexCoord[4].g"
   }
  ],
  "textures": [
   {
    "name": "T_TimberFibre",
    "pixels": "1024 x 1024 8-bit RGB, linear (no sRGB)",
    "sampler": "Masks",
    "use": "R fine fibres, G streaks (also the ring radius jitter), B broad drift; UV0 / 0.25 m, drift at UV0 x 0.11"
   },
   {
    "name": "T_TimberRingNoise",
    "pixels": "1024 x 64 16-bit grey, linear",
    "sampler": "LinearGrayscale",
    "use": "R: ring-width wander row per log seed, bilinear, wrap"
   },
   {
    "name": "T_TimberRingRandom",
    "pixels": "256 x 256 8-bit grey, linear",
    "sampler": "LinearGrayscale",
    "use": "R: per-year latewood strength, NEAREST filtering, wrap"
   },
   {
    "name": "T_<asset>_NormalDX (fallback only)",
    "pixels": "bake, DirectX green",
    "sampler": "Normal",
    "use": "UV1"
   },
   {
    "name": "T_<asset>_Masks (fallback only)",
    "pixels": "bake RGBA, linear",
    "sampler": "Masks",
    "use": "UV1; RGB = cavity, wear, soot; the knot weight is the sample's own alpha output, not a component of RGB"
   },
   {
    "name": "vertex colour Masks (dense)",
    "pixels": "per vertex RGBA floats",
    "sampler": "-",
    "use": "RGB = cavity, wear, soot; A = knot weight (0.55-1.0, dead knots highest)"
   }
  ],
  "ring": {
   "radius": "r = (d < 0 ? r_k : length(UVLogQ)) + (Fibre.G(UV0 / 0.25) - 0.5) * 0.00025",
   "phase": "rho + (RingNoise.R(nu, nv) - 0.5) * WANDER_AMPLITUDE + sum_k a_k sin(2 pi (rho / P_k + 7 seed + c_k)); rho = r / w; nu = r / (WANDER_RINGS_PER_UNIT * w) + seed * 37, nv = frac(seed * 7.31); RingNoise sampled bilinear at the Blender coordinate (sample_blender); (P_k, a_k, c_k) = YEAR_WAVES",
   "wander_rings_per_unit": 300.0,
   "wander_amplitude": 2.6,
   "year_waves": [
    [
     1.7,
     0.07,
     0.11
    ],
    [
     2.9,
     0.1,
     0.48
    ],
    [
     4.3,
     0.12,
     0.85
    ]
   ],
   "year": "the latewood strength per ring, RingRandom NEAREST at ((floor(phase) + seed * 101) / 256, frac(seed * 3.7)); the geometry's raised grain scales with it (YEAR_RELIEF), so the shaded and geometric ridge agree ring by ring",
   "knot_edge": "the select on d is per pixel; anti-alias over the pixel footprint, inside = saturate(0.5 - d / max(fwidth(d), 1e-6))"
  },
  "finish": {
   "presets": {
    "column_fukiurushi": {
     "coat": 0.55,
     "coat_rough": 0.38,
     "rough": 0.62
    }
   },
   "cavity": "roughness + 0.30 x cavity (vertex colour R, or the fallback Masks R); coat weight x (1 - cavity)",
   "fibre": "tone = 0.68 + 0.12 year + 0.22 Fibre.R + 0.16 Fibre.G + 0.34 drift; latewood colour value x (0.85 + 0.30 Fibre.R)"
  }
 }
