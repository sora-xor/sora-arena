  "import_decode": "Interchange imports every channel as (U, 1 - V). Decode with flip_v before reading UV0/UVLogQ/UVLogZ/UVKnot as data; sample shared images at computed Blender coordinates through sample_blender (flip_v again), as import_nyaagyu_dojo_timbers.py (cd10643) does.",
  "channels": [
   {
    "index": 0,
    "blender_layer": "UV0",
    "payload": "metric (s, z): arc length round the section, height (m)",
    "unreal": "flip_v(TexCoord[0])"
   },
   {
    "index": 1,
    "blender_layer": "UV1",
    "payload": "unique bake atlas (fallback NormalDX/Masks)",
    "unreal": "TexCoord[1] as imported"
   },
   {
    "index": 2,
    "blender_layer": "UVLogQ",
    "payload": "signed log-frame offset q = (P - pith) * r_warp / r (m). r_warp adds the periodic wobble (sora_timber_v2.wobble) and every knot's swirl. Continuous across knot edges: no knot-centred swap (that was v2).",
    "unreal": "flip_v(TexCoord[2])"
   },
   {
    "index": 3,
    "blender_layer": "UVLogZ",
    "payload": "(z m, seed01)",
    "unreal": "seed = 1 - TexCoord[3].g"
   },
   {
    "index": 4,
    "blender_layer": "UVKnot",
    "payload": "(knot ring radius r_k in the materials' ring units (0.55 mm knot rings), signed distance d from the knot's edge in knot radii, clamped to [-1, 1]); inside the knot where d < 0. Fallbacks carry (0, 1).",
    "unreal": "r_k = TexCoord[4].r; d = 1 - TexCoord[4].g"
   }
  ],
  "ring": {
   "radius": "r = (d < 0 ? r_k : length(UVLogQ)) + (Fibre.G(UV0 / 0.25) - 0.5) * 0.00025",
   "phase": "r / w + (RingNoise.R(nu, nv) - 0.5) * WANDER_AMPLITUDE, nu = r / (WANDER_RINGS_PER_UNIT * w) + seed * 37, nv = frac(seed * 7.31); RingNoise sampled at the Blender coordinate (sample_blender)",
   "wander_rings_per_unit": 300.0,
   "wander_amplitude": 2.6,
   "knot_edge": "the select on d is per pixel; anti-alias over the pixel footprint, inside = saturate(0.5 - d / max(fwidth(d), 1e-6))"
